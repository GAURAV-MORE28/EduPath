# EduPath environment configuration
# Copy to .env and fill in real values. See docs/EduPath_System_Design.md §35.

ENV=dev

# Database (Docker Compose service name is "postgres"; use localhost outside Compose)
DATABASE_URL=postgresql+asyncpg://edupath:edupath@localhost:5432/edupath
POSTGRES_USER=edupath
POSTGRES_PASSWORD=edupath
POSTGRES_DB=edupath

# Feature flags
# DEMO_MODE=true enables POST /api/demo/seed + /api/demo/scripted-attempt (the seeded persona "Asha" and the
# scripted struggle), records successful live LLM responses for replay, and builds the web UI in demo mode.
DEMO_MODE=false
# REPLAY_MODE=true serves recorded LLM responses first (offline / deterministic demo); a miss falls through to live.
REPLAY_MODE=false

# LLM Gateway (provider-agnostic; "none" disables real calls and degrades deterministically)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_SMALL_MODEL=
LLM_MID_MODEL=
LLM_STRONG_MODEL=
# "anthropic" is the one implemented provider. Model ids per tier are required with it, e.g.
#   LLM_SMALL_MODEL=claude-haiku-4-5-20251001  LLM_MID_MODEL=claude-sonnet-5  LLM_STRONG_MODEL=claude-opus-5
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_S=8
# Record every successful live response into the llm_replay_entries table (implied by DEMO_MODE).
LLM_RECORD=false
# Optional pricing (USD per 1k tokens) so run records report cost where the provider returns usage.
LLM_COST_PER_1K_INPUT_USD=0
LLM_COST_PER_1K_OUTPUT_USD=0

# Session / auth boundary
SESSION_SECRET=change-me-in-production

# GitHub tool (design §26.2 github_repo_summary) -- optional; unauthenticated
# requests work but are more tightly rate-limited by GitHub's API.
GITHUB_TOKEN=

# Document storage (design §35: local volume in dev)
DOCUMENT_STORAGE_DIR=./storage/documents

# Curated domain pack (data/dataset). Empty = repo-relative default; Compose mounts ./data at /data.
DATASET_DIR=
# Ingest the domain pack on API start when the catalog is empty (never re-ingests a populated catalog).
AUTO_SEED_CATALOG=true

# Frontend origin (for CORS) / API base (for the Next.js client)
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
