# EduPath environment configuration
# Copy to .env and fill in real values. See docs/EduPath_System_Design.md §35.

ENV=dev

# Database (Docker Compose service name is "postgres"; use localhost outside Compose)
DATABASE_URL=postgresql+asyncpg://edupath:edupath@localhost:5432/edupath
POSTGRES_USER=edupath
POSTGRES_PASSWORD=edupath
POSTGRES_DB=edupath

# Feature flags
# DEMO_MODE=true enables POST /api/demo/seed + /api/demo/scripted-attempt (the seeded persona "Asha" and the
# scripted struggle), records successful live LLM responses for replay, and builds the web UI in demo mode.
DEMO_MODE=false
# REPLAY_MODE=true serves recorded LLM responses first (offline / deterministic demo); a miss falls through to live.
REPLAY_MODE=false

# --- LLM Gateway (design 7, 33.2) ------------------------------------------------------------------
# "none" = deterministic agents (offline, no key). "groq" (free tier; OpenAI-compatible), "huggingface"
# (the HF router; uses HF_TOKEN) or "anthropic".
LLM_PROVIDER=none
LLM_API_KEY=
# Three tiers. Suggested for Groq (models verified live):
#   small  openai/gpt-oss-20b    intent / disambiguation / blind-solver / grading
#   mid    openai/gpt-oss-120b   Planner, document extractor
#   strong openai/gpt-oss-120b   Assessor generation, Reflection, Tutor
# (qwen/qwen3.8-27b also works but was slow under the free tier's throttling.)
LLM_SMALL_MODEL=
LLM_MID_MODEL=
LLM_STRONG_MODEL=
LLM_BASE_URL=
LLM_JSON_MODE=true
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=25
# Record every successful live response into llm_replay_entries (implied by DEMO_MODE).
LLM_RECORD=false
# Optional pricing (USD per 1k tokens) so run records report cost where the provider returns usage.
LLM_COST_PER_1K_INPUT_USD=0
LLM_COST_PER_1K_OUTPUT_USD=0

# --- Hugging Face: embeddings + vision --------------------------------------------------------------
HF_TOKEN=
# "huggingface" = Qwen3-Embedding (truncated to 256 dims). Catalog and query vectors must come from the
# same provider: after changing this on a seeded database run `python scripts/reembed_catalog.py`.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Vision fallback for scanned PDFs / images: "huggingface" (uses HF_TOKEN).
VLM_PROVIDER=none
VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash:novita

# --- Web search (unvetted suggestions only; never enters a plan) -------------------------------------
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
# Comma-separated; empty = a built-in allowlist of learning sites.
WEB_SEARCH_ALLOWED_DOMAINS=

# Session / auth boundary
SESSION_SECRET=change-me-in-production

# GitHub tool (design §26.2 github_repo_summary) -- optional; unauthenticated
# requests work but are more tightly rate-limited by GitHub's API.
GITHUB_TOKEN=

# Document storage (design §35: local volume in dev)
DOCUMENT_STORAGE_DIR=./storage/documents

# Curated domain pack (data/dataset). Empty = repo-relative default; Compose mounts ./data at /data.
DATASET_DIR=
# Ingest the domain pack on API start when the catalog is empty (never re-ingests a populated catalog).
AUTO_SEED_CATALOG=true

# Frontend origin (for CORS) / API base (for the Next.js client)
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
