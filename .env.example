# EduPath environment configuration
# Copy to .env and fill in real values. See docs/EduPath_System_Design.md §35.

ENV=dev

# Database (Docker Compose service name is "postgres"; use localhost outside Compose)
DATABASE_URL=postgresql+asyncpg://edupath:edupath@localhost:5432/edupath
POSTGRES_USER=edupath
POSTGRES_PASSWORD=edupath
POSTGRES_DB=edupath

# Feature flags
REPLAY_MODE=false
DEMO_MODE=false

# LLM Gateway (provider-agnostic; "none" disables real calls and degrades deterministically)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_SMALL_MODEL=
LLM_MID_MODEL=
LLM_STRONG_MODEL=

# Session / auth boundary
SESSION_SECRET=change-me-in-production

# GitHub tool (design §26.2 github_repo_summary) -- optional; unauthenticated
# requests work but are more tightly rate-limited by GitHub's API.
GITHUB_TOKEN=

# Document storage (design §35: local volume in dev)
DOCUMENT_STORAGE_DIR=./storage/documents

# Frontend origin (for CORS) / API base (for the Next.js client)
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
